<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.model.3d</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="3D Model" name="model_3d">
                    <!-- Source upload with inline filename, size, action button, and error message -->
                    <field
                        name="model_3d_source"
                        widget="model_3d_source_upload"
                        filename="model_3d_source_filename"
                    />
                    <field name="model_3d_source_filename" invisible="1" />
                    <field name="model_3d_source_size_kb" invisible="1" />
                    <field name="model_3d_conversion_state" invisible="1" />
                    <field name="model_3d_conversion_error" invisible="1" />

                    <!-- model_viewer_3d: handles loading, error, hint, placeholder, and download link -->
                    <!-- Hidden only in draft state when no source file has been uploaded yet          -->
                    <field
                        name="model_3d"
                        widget="model_viewer_3d"
                        filename="model_3d_filename"
                        invisible="model_3d_conversion_state == 'draft' and not model_3d_source"
                    />
                    <field name="model_3d_filename" invisible="1" />

                    <!-- Job UUID: visible to admins for queue monitor traceability -->
                    <field
                        name="model_3d_job_uuid"
                        readonly="1"
                        invisible="not model_3d_job_uuid"
                    />
                </page>
            </notebook>
        </field>
    </record>
</odoo>
